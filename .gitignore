# Virtual environments and dependencies
/env/
/venv/
/.venv/
/doft_v12/
__pycache__/
*.pyc

# Simulation results and artifacts
# This is the most important rule.
/results/
/runs/
*.csv
*.png
*.log
*.json  # Ignore JSON in general, but NOT inside the configs directory
!configs/*.json

# Operating-system and editor files
.DS_Store
.vscode/
.idea/

# Patch-script backups
*.bak
